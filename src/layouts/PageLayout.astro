---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import StarfieldBg from "@components/StarfieldBg.astro"
import { SITE } from "@consts"

interface Props {
  title: string
  description?: string
  hideStarfield?: boolean
  locale?: "ca" | "en" | "es"
}

const { title, description = SITE.DESCRIPTION, hideStarfield = false, locale } = Astro.props

const pathname = Astro.url.pathname
let detectedLocale = locale
if (!detectedLocale) {
  if (pathname === "/en" || pathname.startsWith("/en/")) {
    detectedLocale = "en"
  } else if (pathname === "/es" || pathname.startsWith("/es/")) {
    detectedLocale = "es"
  } else {
    detectedLocale = "ca"
  }
}
---

<!doctype html>
<html lang={detectedLocale}>
  <head>
    <BaseHead title={`${title} | ${SITE.TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <Drawer />
    {!hideStarfield && <StarfieldBg />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
